# Copy to real-b.env and fill in the three addresses before starting real B.
# This is a Bash configuration file. No robot address is guessed.
SAWYER_ROBOT_HOST=""
# B's IPv4 on the robot network (reachable FROM the robot).
SAWYER_ROS_IP=""
# B's IPv4 reachable FROM Windows A; may equal SAWYER_ROS_IP.
SAWYER_BIND_IP=""

SAWYER_ROS_SETUP="/opt/ros/noetic/setup.bash"
# Built catkin workspace containing intera_sdk (devel/setup.bash).
SAWYER_WORKSPACE="$HOME/sawyer_ws"
# Optional interpreter; defaults to project .venv-b/bin/python, then python3.
SAWYER_B_PYTHON=""
