# 实验室实体 Sawyer B 配置，直接入库；Start-B-Real.sh 默认读取本文件。
# 同一台实验室电脑可直接使用。换电脑或网络变化时核对以下 IP、路径和串口。
# Bash 配置文件，可使用 $HOME；不在本文件中存放密码或 Token。
# 机器人主机名或 IPv4，不含 http:// 或端口。
SAWYER_ROBOT_HOST="sawyer.local"
# B 电脑连接机器人网卡的 IPv4，机器人必须能回连；换电脑需检查。
SAWYER_ROS_IP="10.101.119.182"
# A 能访问的 B 电脑 IPv4，A 界面填写此地址；可与上一项相同。
SAWYER_BIND_IP="10.101.119.182"

# 本机 ROS Noetic 及已编译、包含 Intera SDK 的 catkin 工作空间。
SAWYER_ROS_SETUP="/opt/ros/noetic/setup.bash"
SAWYER_WORKSPACE="$HOME/sawyer_ws"
# 留空时优先使用项目 .venv-b/bin/python，其次 python3；须能导入 ROS 依赖。
SAWYER_B_PYTHON=""

# 实验室外接 Dynamixel 夹爪的串口适配器标识；更换硬件后需核对。
# 没有外接夹爪时设为空字符串。启用后启动 B 会初始化夹爪。
SAWYER_GRIPPER_PORT="/dev/serial/by-id/usb-FTDI_USB__-__Serial_Converter_FTAO9VMQ-if00-port0"
